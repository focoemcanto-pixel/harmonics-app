# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=
APP_BASE_URL=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Contratos (Google)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
CONTRACT_TEMPLATE_DOC_ID=
CONTRACTS_DRIVE_FOLDER_ID=
NEXT_PUBLIC_CONTRACT_SERVICE_URL=

# Nara V2 road geography (admin test chat only; enable after configuration).
# Use a contracted or self-hosted Nominatim HTTPS instance, not the public OSMF instance.
AI_NARA_ROAD_GEO_ENABLED=false
# Optional: use Geoapify for both geocoding and road routes. Store the key server-side only.
AI_NARA_GEOAPIFY_API_KEY=
AI_NARA_NOMINATIM_URL=
# Contracted or self-hosted OSRM car routing.
AI_NARA_OSRM_URL=
# Bump when the deployed map data, routing profile, or provider configuration changes.
AI_NARA_MAPS_REVISION=
# Explicit opt-in for billable OpenAI web searches.
AI_VENUE_WEB_SEARCH_ENABLED=false
